<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Quacky" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/quacky_background</item>
        <item name="android:navigationBarColor">@color/quacky_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/quacky_background</item>
    </style>

    <!-- SplashScreen Theme using AndroidX SplashScreen -->
    <style name="Theme.Quacky.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/quacky_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Quacky</item>
    </style>
</resources>
